{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ISOCraft",
  "version": "0.2.0",
  "identifier": "dev.isocraft.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "createUpdaterArtifacts": true,
    "publisher": "Lunqasd1337",
    "copyright": "Copyright (c) 2026 Lunqasd1337",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/**/*"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJCMjQ3NzQzNzc4MTFBQTQKUldTa0dvRjNRM2NrSzRxelBTRFJLV0I4RCtMY3c1RHJTU0VxUWJVNDlsSDJxNUFEekFzNXZIbXUK",
      "endpoints": [
        "https://github.com/Lunqasd1337/ISOCraft/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}